---
import "../styles/landing.css";
import Hero from "../components/Hero.astro";
import StatsStrip from "../components/StatsStrip.astro";
import BenchPreview from "../components/BenchPreview.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import TemplateShowcase from "../components/TemplateShowcase.astro";
import CtaBanner from "../components/CtaBanner.astro";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content="Deliberately boring full-stack boilerplate — Hono + bun:sqlite + Inertia v3 on Bun." />
    <link rel="icon" href="/favicon.svg" />
    <title>Dulak — deliberately boring full-stack starter</title>
  </head>
  <body>
    <header class="dl-nav">
      <a class="dl-nav-brand" href="/">
        <img src="/favicon.svg" alt="" width="24" height="24" />
        <span>Dulak</span>
      </a>
      <nav class="dl-nav-links">
        <a href="/getting-started/introduction/">Docs</a>
        <a href="https://github.com/maulanashalihin/dulak" target="_blank" rel="noreferrer">GitHub</a>
      </nav>
    </header>

    <main>
      <Hero />
      <StatsStrip />
      <BenchPreview />
      <FeatureGrid />
      <CtaBanner />
    </main>

    <footer class="dl-footer">
      <span>Dulak — the Banjar word for <em>bored</em>.</span>
      <a href="/getting-started/introduction/">Read the docs</a>
    </footer>
  </body>
</html>
