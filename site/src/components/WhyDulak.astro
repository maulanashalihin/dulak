---
const reasons = [
  {
    n: "01",
    title: "Boring means predictable",
    blurb: "Routes in one place, SQL in one file, env in one module — no guessing where things live. No clever tricks to figure out. Whoever comes next — human or AI — can read it and change it without fear of breaking it.",
    icon: "M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.821 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.821 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.821 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.821 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.821 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.821 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.821-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.821-1.946 3.42 3.42 0 013.138-3.138z",
  },
  {
    n: "02",
    title: "Everything in one runtime",
    blurb: "No separate language, package manager, web server, and database to install and configure. Bun does all of it — one install, one runtime, and your app is running with auth, SSR, and tests already working.",
    icon: "M4 5h16v14H4zM9 9h6M9 13h6M4 17h16",
  },
  {
    n: "03",
    title: "Built for AI agents",
    blurb: "Conventions codified in AGENTS.md, validation errors with exact shapes, strict TypeScript that fails at compile time, deterministic tests as the safety net. A codebase an agent can extend without inventing conventions stays coherent.",
    icon: "M12 2a4 4 0 014 4v1h1a3 3 0 013 3v3a5 5 0 01-5 5h-6a5 5 0 01-5-5V10a3 3 0 013-3h1V6a4 4 0 014-4z",
  },
];
---

<section class="dl-why">
  <p class="dl-kicker rv">Philosophy</p>
  <h2 class="dl-section-title rv">Why Dulak <span class="dl-accent">exists</span></h2>
  <p class="dl-section-sub rv rv-d1">Because your first week should be business logic, not infrastructure.</p>
  <div class="dl-why-grid">
    {reasons.map((r, i) => (
      <div class={`dl-why-card rv ${i === 1 ? "rv-d1" : i === 2 ? "rv-d2" : ""}`}>
        <span class="dl-why-num" aria-hidden="true">{r.n}</span>
        <div class="dl-why-head">
          <span class="dl-why-icon">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={r.icon} />
            </svg>
          </span>
          <h3>{r.title}</h3>
        </div>
        <p>{r.blurb}</p>
      </div>
    ))}
  </div>
  <p class="dl-why-link rv">For the full reasoning, read the <a href="/philosophy/">philosophy page →</a>.</p>
</section>

<style>
  .dl-why { max-width: 1000px; margin: 0 auto 5rem; padding: 0 1.5rem; }
  .dl-kicker {
    text-align: center;
    font-family: var(--dl-mono);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--dl-accent);
    margin: 0 0 0.9rem;
  }
  .dl-why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }
  .dl-why-card {
    position: relative;
    border: 1px solid var(--dl-line);
    border-radius: 1rem;
    padding: 1.6rem 1.5rem 1.5rem;
    background: linear-gradient(180deg, #0e141b, #090d12);
    overflow: hidden;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }
  .dl-why-card:hover {
    border-color: rgba(52, 211, 153, 0.4);
    transform: translateY(-3px);
  }
  .dl-why-num {
    position: absolute;
    top: -0.4rem;
    right: 0.7rem;
    font-size: 4.2rem;
    font-weight: 800;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(52, 211, 153, 0.16);
    user-select: none;
    pointer-events: none;
  }
  .dl-why-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.7rem;
  }
  .dl-why-head h3 { margin: 0; font-size: 1.05rem; letter-spacing: -0.01em; }
  .dl-why-icon {
    display: inline-flex;
    padding: 0.55rem;
    border-radius: 0.65rem;
    background: rgba(5, 150, 105, 0.13);
    border: 1px solid rgba(52, 211, 153, 0.22);
    color: #34d399;
    flex-shrink: 0;
  }
  .dl-why-card p { margin: 0; font-size: 0.89rem; line-height: 1.65; color: #9aa4b2; }
  .dl-why-link {
    text-align: center;
    margin: 2.2rem 0 0;
    color: #8b95a5;
    font-size: 0.92rem;
  }
  .dl-why-link a {
    color: #34d399;
    text-decoration: none;
    font-weight: 600;
  }
  .dl-why-link a:hover {
    text-decoration: underline;
  }
</style>
