---
const rows = [
  { op: "Point read via HTTP", detail: "GET /users/:id · p99 2.6ms · median of 3", value: "52K", unit: "req/s" },
  { op: "Create via HTTP", detail: "POST /users · p99 14ms · median of 3", value: "19.6K", unit: "req/s" },
  { op: "Point read (direct)", detail: "bun:sqlite prepared stmt · no HTTP", value: "526K", unit: "ops/s" },
  { op: "Autocommit insert (direct)", detail: "WAL + synchronous=NORMAL · no HTTP", value: "95K", unit: "ops/s" },
  { op: "Transactional insert (direct)", detail: "db.transaction() · 0.75µs/row", value: "1.3M", unit: "ops/s" },
];

const compare = [
  { op: "Health (no DB)", dulak: "66K", laravel: "6K", x: "10.5", note: "same box, same SQLite WAL" },
  { op: "Point read", dulak: "52K", laravel: "6K", x: "8.1", note: "p99 2.6ms vs 41ms" },
  { op: "List 20 rows", dulak: "32K", laravel: "5K", x: "6.8", note: "one query, no N+1" },
  { op: "Delete", dulak: "28K", laravel: "6K", x: "4.9", note: "transactional" },
];
---
<section class="dl-bench">
  <p class="dl-kicker rv">Benchmarks</p>
  <h2 class="dl-section-title rv">Numbers from <span class="dl-accent">real hardware</span></h2>
  <p class="dl-section-sub rv rv-d1">
    bun:sqlite + Hono on Apple M4, measured — not estimated.
    <a href="/database/performance/">Full benchmark →</a>
  </p>

  <div class="dl-bench-grid">
    {compare.map((c, i) => (
      <div class={`dl-vs-card rv ${i === 1 ? "rv-d1" : i === 2 ? "rv-d2" : i === 3 ? "rv-d3" : ""}`}>
        <div class="dl-vs-op">{c.op}</div>
        <div class="dl-vs-x"><span data-x={c.x}>0</span>×</div>
        <div class="dl-vs-sub">faster than Laravel</div>
        <div class="dl-vs-nums">
          <span class="dl-vs-dulak">{c.dulak}</span>
          <span class="dl-vs-sep">vs</span>
          <span class="dl-vs-lar">{c.laravel}</span>
        </div>
        <div class="dl-vs-note">{c.note}</div>
      </div>
    ))}
  </div>
  <p class="dl-bench-vs-label rv">vs Laravel 13 + FrankenPHP · 8 workers · same SQLite WAL · same machine</p>

  <p class="dl-bench-legend rv">
    <span class="dl-bench-legend-item"><span class="dl-bench-legend-dot dl-bench-legend-http"></span>via HTTP = full stack, what users experience</span>
    <span class="dl-bench-legend-item"><span class="dl-bench-legend-dot dl-bench-legend-direct"></span>direct = raw bun:sqlite, no HTTP layer</span>
  </p>
  <div class="dl-bench-table-wrap rv">
    <table class="dl-bench-table">
      <thead>
        <tr><th>Operation</th><th>Detail</th><th class="num">Throughput</th></tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td class="op">{r.op}</td>
            <td class="detail">{r.detail}</td>
            <td class="num"><strong>{r.value}</strong> <span>{r.unit}</span></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<script>
  // Count up the "× faster" multiples when they scroll into view
  const xs = document.querySelectorAll<HTMLElement>("[data-x]");
  const runX = (el: HTMLElement) => {
    const target = Number(el.dataset.x || "0");
    const t0 = performance.now();
    const dur = 1300;
    const tick = (now: number) => {
      const p = Math.min(1, (now - t0) / dur);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = (target * eased).toFixed(1);
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => {
        if (e.isIntersecting) {
          runX(e.target as HTMLElement);
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.6 });
    xs.forEach((el) => io.observe(el));
  } else {
    xs.forEach(runX);
  }
</script>

<style>
  .dl-bench { max-width: 960px; margin: 0 auto 5rem; padding: 0 1.5rem; }
  .dl-kicker {
    text-align: center;
    font-family: var(--dl-mono);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--dl-accent);
    margin: 0 0 0.9rem;
  }

  .dl-bench-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.9rem;
    margin-bottom: 1rem;
  }
  .dl-vs-card {
    position: relative;
    border: 1px solid var(--dl-line);
    border-radius: 1rem;
    padding: 1.5rem 1.3rem;
    background: linear-gradient(180deg, #0e141c, #090d12);
    text-align: center;
    overflow: hidden;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }
  .dl-vs-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 15%;
    right: 15%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(52, 211, 153, 0.65), transparent);
  }
  .dl-vs-card:hover {
    border-color: rgba(52, 211, 153, 0.45);
    transform: translateY(-3px);
  }
  .dl-vs-op {
    font-size: 0.78rem;
    color: var(--dl-muted);
    font-family: var(--dl-mono);
  }
  .dl-vs-x {
    font-size: 2.9rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--dl-accent);
    font-variant-numeric: tabular-nums;
    line-height: 1.15;
    text-shadow: 0 0 34px rgba(52, 211, 153, 0.4);
  }
  .dl-vs-sub {
    font-size: 0.78rem;
    color: var(--dl-faint);
    margin-bottom: 0.9rem;
  }
  .dl-vs-nums {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--dl-mono);
    font-size: 0.85rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--dl-line-soft);
  }
  .dl-vs-dulak { color: var(--dl-ink); font-weight: 700; }
  .dl-vs-sep { color: var(--dl-faint); font-size: 0.72rem; }
  .dl-vs-lar { color: var(--dl-faint); }
  .dl-vs-note {
    margin-top: 0.4rem;
    font-size: 0.72rem;
    color: var(--dl-faint);
    font-family: var(--dl-mono);
  }
  .dl-bench-vs-label {
    text-align: center;
    font-family: var(--dl-mono);
    font-size: 0.74rem;
    color: var(--dl-faint);
    margin: 0 0 2.4rem;
  }

  .dl-bench-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    justify-content: center;
    margin: 0 0 1.1rem;
    font-size: 0.8rem;
    color: var(--dl-muted);
  }
  .dl-bench-legend-item { display: inline-flex; align-items: center; gap: 0.45rem; }
  .dl-bench-legend-dot { width: 9px; height: 9px; border-radius: 50%; }
  .dl-bench-legend-http { background: #34d399; box-shadow: 0 0 8px rgba(52, 211, 153, 0.7); }
  .dl-bench-legend-direct { background: #0d9488; }

  .dl-bench-table-wrap {
    border: 1px solid var(--dl-line);
    border-radius: 1rem;
    overflow: hidden;
    overflow-x: auto;
    background: #0a0e13;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
  }
  .dl-bench-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.86rem;
    min-width: 560px;
  }
  .dl-bench-table th {
    text-align: left;
    font-family: var(--dl-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dl-faint);
    font-weight: 600;
    padding: 0.85rem 1.1rem;
    border-bottom: 1px solid var(--dl-line);
    background: rgba(52, 211, 153, 0.03);
  }
  .dl-bench-table td {
    padding: 0.8rem 1.1rem;
    border-bottom: 1px solid var(--dl-line-soft);
    color: #c6ced8;
  }
  .dl-bench-table tbody tr:last-child td { border-bottom: none; }
  .dl-bench-table tbody tr { transition: background 0.2s ease; }
  .dl-bench-table tbody tr:hover { background: rgba(52, 211, 153, 0.045); }
  .dl-bench-table td.op { font-weight: 600; color: var(--dl-ink); white-space: nowrap; }
  .dl-bench-table td.detail { color: var(--dl-faint); font-family: var(--dl-mono); font-size: 0.76rem; }
  .dl-bench-table .num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .dl-bench-table .num strong { color: var(--dl-accent); font-size: 1rem; }
  .dl-bench-table .num span { color: var(--dl-faint); font-size: 0.74rem; }
</style>
