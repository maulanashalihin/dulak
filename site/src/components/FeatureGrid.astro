---
interface Feature {
  title: string;
  blurb: string;
  icon: string; // inline SVG path data, 24x24, stroke style
}

const features: Feature[] = [
  {
    title: "Auth, complete",
    blurb: "Register, login, logout, forgot/reset password and Google OAuth — argon2id, DB-backed sessions, CSRF, rate-limited.",
    icon: "M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm7.4-3a7.4 7.4 0 0 1-.1 1.3l2 1.6-2 3.4-2.4-1a7.4 7.4 0 0 1-2.2 1.3L14.4 21h-4l-.3-2.4a7.4 7.4 0 0 1-2.2-1.3l-2.4 1-2-3.4 2-1.6a7.4 7.4 0 0 1 0-2.6l-2-1.6 2-3.4 2.4 1a7.4 7.4 0 0 1 2.2-1.3L10.4 3h4l.3 2.4a7.4 7.4 0 0 1 2.2 1.3l2.4-1 2 3.4-2 1.6c.07.4.1.9.1 1.3Z",
  },
  {
    title: "Inertia v3 + SSR",
    blurb: "Full HTML on first load, SPA after. In-process SSR, 409 version negotiation, partial reloads, one-shot flash.",
    icon: "M3 6h18M3 12h18M3 18h18M8 4v4M16 10v4M12 16v4",
  },
  {
    title: "Resumable uploads",
    blurb: "tus protocol v1: creation, resume, checksum, termination, expiration — proven by the avatar upload.",
    icon: "M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2",
  },
  {
    title: "One server, three clients",
    blurb: "React, Svelte 5, and Vue 3 templates with Tailwind CSS v4 — same auth, SSR, and test suite.",
    icon: "M4 5h16v14H4zM9 9h6M9 13h6M4 17h16",
  },
  {
    title: "Migrations & SQL",
    blurb: "Versioned SQL applied at startup in transactions. Zero-ORM bun:sqlite, prepared statements only.",
    icon: "M4 7h16M4 12h16M4 17h10M9 4v6M15 14v6",
  },
  {
    title: "Production-grade ops",
    blurb: "Batched logging, gzip, security headers, /health, graceful shutdown, multi-stage Docker, CI.",
    icon: "M12 3l8 4v5c0 5-3.4 8.5-8 11-4.6-2.5-8-6-8-11V7l8-4Zm-3 9 2 2 4-4",
  },
];

const delays = ["", "rv-d1", "rv-d2", "", "rv-d1", "rv-d2"];
---

<section class="dl-features">
  <p class="dl-kicker rv">Everything wired</p>
  <h2 class="dl-section-title rv">Working code, <span class="dl-accent">not wiring homework</span></h2>
  <p class="dl-section-sub rv rv-d1">Auth, uploads, migrations, SSR, tests, Docker — running end to end, not left for you to wire.</p>
  <div class="dl-feature-grid">
    {features.map((f, i) => (
      <div class={`dl-feature-card spot rv ${delays[i % delays.length]}`}>
        <div class="dl-feature-head">
          <span class="dl-feature-icon">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={f.icon} />
            </svg>
          </span>
          <h3>{f.title}</h3>
        </div>
        <p>{f.blurb}</p>
      </div>
    ))}
  </div>
</section>

<script>
  // Mouse-follow spotlight for feature cards
  document.querySelectorAll(".dl-feature-card.spot").forEach((c) => {
    c.addEventListener("mousemove", (e: Event) => {
      const me = e as MouseEvent;
      const r = (c as HTMLElement).getBoundingClientRect();
      (c as HTMLElement).style.setProperty("--mx", `${me.clientX - r.left}px`);
      (c as HTMLElement).style.setProperty("--my", `${me.clientY - r.top}px`);
    });
  });
</script>

<style>
  .dl-features { max-width: 1000px; margin: 0 auto 5rem; padding: 0 1.5rem; }
  .dl-kicker {
    text-align: center;
    font-family: var(--dl-mono);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--dl-accent);
    margin: 0 0 0.9rem;
  }
  .dl-feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }
  .dl-feature-card {
    position: relative;
    border: 1px solid var(--dl-line);
    border-radius: 1rem;
    padding: 1.5rem;
    background: linear-gradient(180deg, #0e141b, #090d12);
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
    overflow: hidden;
  }
  .dl-feature-card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(
      380px circle at var(--mx, 50%) var(--my, 50%),
      rgba(52, 211, 153, 0.1),
      transparent 65%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .dl-feature-card:hover::before { opacity: 1; }
  .dl-feature-card:hover {
    border-color: rgba(52, 211, 153, 0.4);
    transform: translateY(-3px);
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.45), 0 0 32px rgba(5, 150, 105, 0.1);
  }
  .dl-feature-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.7rem;
  }
  .dl-feature-head h3 { margin: 0; font-size: 1.02rem; letter-spacing: -0.01em; }
  .dl-feature-icon {
    display: inline-flex;
    padding: 0.55rem;
    border-radius: 0.65rem;
    background: rgba(5, 150, 105, 0.13);
    border: 1px solid rgba(52, 211, 153, 0.22);
    color: #34d399;
    flex-shrink: 0;
    box-shadow: 0 0 18px rgba(52, 211, 153, 0.12);
  }
  .dl-feature-card p { margin: 0; font-size: 0.88rem; line-height: 1.6; color: #9aa4b2; }
</style>
