---
const stats = [
  { value: "1", label: "server, three clients" },
  { value: "62", label: "E2E tests" },
  { value: "6", label: "templates" },
  { value: "0", label: "CSS frameworks required" },
];
---

<div class="dl-stats">
  {stats.map((s) => (
    <div class="dl-stat">
      <span class="dl-stat-value">{s.value}</span>
      <span class="dl-stat-label">{s.label}</span>
    </div>
  ))}
</div>

<style>
  .dl-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1px;
    background: #1f2937;
    border: 1px solid #1f2937;
    border-radius: 0.75rem;
    overflow: hidden;
    max-width: 760px;
    margin: 4.5rem auto 4.5rem;
  }
  .dl-stat {
    background: #0f141a;
    padding: 1.4rem 1rem;
    text-align: center;
  }
  .dl-stat-value {
    display: block;
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #34d399;
  }
  .dl-stat-label {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.82rem;
    color: #8b95a5;
  }
</style>
