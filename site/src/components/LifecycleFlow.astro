---
const steps = [
  { name: "requestLogger", desc: "correlation id · batched log" },
  { name: "checkOrigin", desc: "CSRF origin check" },
  { name: "secureHeaders", desc: "CSP · nosniff · HSTS" },
  { name: "inertiaMiddleware", desc: "session → c.var" },
  { name: "guards + handler", desc: "requireAuth · render" },
];
---

<section class="dl-lifecycle">
  <h2 class="dl-section-title">A request, <span class="dl-gradient">end to end</span></h2>
  <p class="dl-section-sub">Middleware runs in order — one obvious way.</p>
  <div class="dl-flow">
    {steps.map((s, i) => (
      <>
        <div class="dl-flow-step">
          <span class="dl-flow-index">{i + 1}</span>
          <code>{s.name}</code>
          <span class="dl-flow-desc">{s.desc}</span>
        </div>
        {i < steps.length - 1 ? <span class="dl-flow-arrow">→</span> : null}
      </>
    ))}
  </div>
</section>

<style>
  .dl-lifecycle { max-width: 900px; margin: 0 auto 4.5rem; padding: 0 1.5rem; }
  .dl-flow {
    display: flex;
    align-items: stretch;
    gap: 0.4rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 1.8rem;
  }
  .dl-flow-step {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    padding: 0.85rem 1rem;
    border: 1px solid #1f2937;
    border-radius: 0.6rem;
    background: #0f141a;
    min-width: 130px;
    transition: border-color 0.2s ease;
  }
  .dl-flow-step:hover { border-color: #059669; }
  .dl-flow-index {
    font-size: 0.7rem;
    color: #34d399;
    font-weight: 700;
  }
  .dl-flow-step code { font-size: 0.8rem; color: #d3dae4; }
  .dl-flow-desc { font-size: 0.72rem; color: #64748b; }
  .dl-flow-arrow {
    align-self: center;
    color: #059669;
    font-size: 1.1rem;
  }
</style>
