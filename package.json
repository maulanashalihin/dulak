{
  "name": "dulak",
  "version": "0.4.0",
  "license": "MIT",
  "description": "Full-stack boilerplate: Hono + bun:sqlite + Inertia v3 (Vue 3) with auth, roles, SSR, scoped CSS, migrations, tests and Docker.",
  "keywords": [
    "dulak",
    "hono",
    "bun",
    "inertia",
    "vue",
    "sqlite",
    "boilerplate",
    "ssr"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maulanashalihin/dulak.git"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "private": false,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun run scripts/build.ts",
    "start": "NODE_ENV=production bun run src/index.ts",
    "db:seed": "bun run scripts/seed.ts",
    "typecheck": "vue-tsc --noEmit",
    "lint": "biome lint src tests scripts create-dulak",
    "test": "bun test --isolate"
  },
  "dependencies": {
    "@inertiajs/vue3": "^3.6.1",
    "@sinclair/typebox": "^0.34.52",
    "@vue/server-renderer": "^3.5.40",
    "hono": "^4.13.0",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "^1.2.0",
    "typescript": "^5.8.0",
    "vue-tsc": "^3.3.9"
  }
}
