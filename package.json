{
  "name": "dulak",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Full-stack boilerplate: Hono + bun:sqlite + Inertia v3 (Svelte 5) with auth, roles, SSR, scoped CSS, migrations, tests and Docker.",
  "keywords": ["dulak", "hono", "bun", "inertia", "svelte", "sqlite", "boilerplate", "ssr"],
  "repository": {
    "type": "git",
    "url": "https://github.com/maulanashalihin/dulak.git"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "private": false,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun run scripts/build.ts",
    "start": "NODE_ENV=production bun run src/index.ts",
    "db:seed": "bun run scripts/seed.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test --isolate"
  },
  "dependencies": {
    "@inertiajs/svelte": "^3.6.1",
    "@sinclair/typebox": "^0.34.52",
    "hono": "^4.13.0",
    "svelte": "^5.56.8"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "svelte-check": "^4.7.4",
    "typescript": "^5.8.0"
  }
}
