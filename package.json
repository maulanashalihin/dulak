{
  "name": "dulak",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Full-stack boilerplate: Elysia + bun:sqlite + Inertia v3 (React 19) with auth, roles, SSR, migrations, tests and Docker.",
  "keywords": ["dulak", "elysia", "bun", "inertia", "react", "sqlite", "boilerplate", "ssr"],
  "repository": {
    "type": "git",
    "url": "https://github.com/maulanashalihin/dulak.git"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "private": false,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun run scripts/build.ts",
    "start": "NODE_ENV=production bun run src/index.ts",
    "db:seed": "bun run scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --isolate"
  },
  "dependencies": {
    "@inertiajs/react": "^3.0.0",
    "elysia": "^1.4.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.0"
  }
}
